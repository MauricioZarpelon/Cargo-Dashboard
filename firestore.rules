rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só o usuário compartilhado (o mesmo e-mail de "sharedEmail" em fonte/firebase-config.json) lê e grava.
    match /kv/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'seu-email-compartilhado@exemplo.com';
    }
  }
}
